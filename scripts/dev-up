#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKEND_DIR="$ROOT_DIR/backend/backend"
FRONTEND_DIR="$ROOT_DIR/frontend/frontend"

PIDS=()

cleanup() {
  for pid in "${PIDS[@]:-}"; do
    if kill -0 "$pid" >/dev/null 2>&1; then
      kill "$pid" >/dev/null 2>&1 || true
    fi
  done
  wait >/dev/null 2>&1 || true
}

trap cleanup EXIT INT TERM

echo "[dev-up] starting backend: npm run start:dev --prefix $BACKEND_DIR"
npm run start:dev --prefix "$BACKEND_DIR" &
PIDS+=("$!")

echo "[dev-up] starting frontend: npm run dev --prefix $FRONTEND_DIR"
npm run dev --prefix "$FRONTEND_DIR" &
PIDS+=("$!")

echo "[dev-up] backend pid=${PIDS[0]} frontend pid=${PIDS[1]}"
echo "[dev-up] press Ctrl+C to stop both"

while true; do
  for pid in "${PIDS[@]}"; do
    if ! kill -0 "$pid" >/dev/null 2>&1; then
      wait "$pid"
      exit $?
    fi
  done
  sleep 1
done
