NODE_ENV=development
PORT=3001

MONGO_URI=mongodb://127.0.0.1:27017/discreet
REDIS_URL=redis://127.0.0.1:6379

FRONTEND_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
SERVER_BASE_URL=http://localhost:3001
WS_CORS_ORIGINS=http://localhost:3000
OAUTH_ALLOWED_REDIRECT_HOSTS=localhost,127.0.0.1

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

JWT_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

DISCORD_CLIENT_ID=replace-me
DISCORD_CLIENT_SECRET=replace-me
DISCORD_REDIRECT_URI=http://localhost:3001/api/docs/oauth2-redirect.html
DISCORD_OAUTH2_URL=https://discord.com/oauth2/authorize
DISCORD_BOT_TOKEN=replace-me
DISCORD_BOT_ID=replace-me

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=replace-me@example.com
EMAIL_PASSWORD=replace-me

CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

ONDATO_WEBHOOK_USER=replace-me
ONDATO_WEBHOOK_PASSWORD=replace-me
ONDATO_WEBHOOK_SECRET=replace-me

ALLOW_LOCAL_WALLET_FUND=false

PRIVY_APP_ID=replace-me
PRIVY_SECRET=replace-me
